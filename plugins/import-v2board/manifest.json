{
  "id": "import-v2board",
  "name": "从 V2Board 导入",
  "version": "0.0.1",
  "apiVersion": "1.0",
  "description": "保留原密码、连接凭据、余额、流量和套餐信息，支持导入预览与冲突检查",
  "category": "迁移",
  "author": "PxBoard",
  "dependencies": {
    "subscriptions": ">=1!0.0.1",
    "commerce": ">=1!0.0.1",
    "access": ">=1!0.0.1",
    "nodes": ">=1!0.0.1"
  },
  "permissions": [
    "storage:own",
    "import:users",
    "import:settings",
    "import:access",
    "import:nodes",
    "import:commerce",
    "import:affiliate",
    "import:subscriptions",
    "import:import-v2board"
  ],
  "pages": [
    {
      "group": "迁移",
      "roles": [
        "admin"
      ],
      "icon": "database",
      "title": "V2Board",
      "id": "migration",
      "shared": {
        "id": "migration",
        "title": "数据迁移",
        "selectorLabel": "来源面板"
      }
    }
  ],
  "minCoreVersion": "1!0.0.1",
  "versionEpoch": 1,
  "requiredImportRules": {
    "access": [
      "accounts"
    ],
    "subscriptions": [
      "links",
      "templates"
    ],
    "nodes": [
      "nodes",
      "machines"
    ]
  }
}
