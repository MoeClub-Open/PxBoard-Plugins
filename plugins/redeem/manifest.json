{
  "id": "redeem",
  "apiVersion": "1.0",
  "minCoreVersion": "1!0.0.1",
  "name": "兑换码",
  "version": "0.0.1",
  "description": "独立兑换码、访问权益与可选余额兑换",
  "category": "账户",
  "author": "PxBoard",
  "dependencies": {
    "access": ">=1!0.0.1"
  },
  "permissions": [
    "storage:own",
    "users:read",
    "call:access",
    "call:commerce"
  ],
  "events": [
    "system.tick"
  ],
  "pages": [
    {
      "id": "codes",
      "title": "兑换码",
      "icon": "gift",
      "group": "账户",
      "surface": "admin",
      "roles": [
        "admin"
      ]
    },
    {
      "id": "redeem",
      "title": "兑换码",
      "icon": "gift",
      "group": "账户",
      "surface": "portal",
      "roles": [
        "admin",
        "member"
      ]
    },
    {
      "id": "claims",
      "title": "兑换记录",
      "icon": "receipt",
      "group": "账户",
      "surface": "admin",
      "roles": [
        "admin"
      ]
    }
  ],
  "versionEpoch": 1,
  "importRules": [
    {
      "collection": "codes",
      "required": [
        "code",
        "name",
        "kind"
      ],
      "unique": [
        "code"
      ]
    },
    {
      "collection": "claims",
      "required": [
        "codeId",
        "userId",
        "status"
      ],
      "userField": "userId"
    }
  ]
}
