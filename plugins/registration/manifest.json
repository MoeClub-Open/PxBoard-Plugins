{
  "id": "registration",
  "apiVersion": "1.0",
  "minCoreVersion": "1!0.0.1",
  "name": "账户注册",
  "version": "0.0.1",
  "description": "独立账户注册、全局注册开关和推广来源记录",
  "category": "账户",
  "author": "PxBoard",
  "dependencies": {},
  "permissions": [
    "storage:own",
    "users:create",
    "emit:account.registered"
  ],
  "events": [
    "system.tick"
  ],
  "capabilities": [
    "auth.registration"
  ],
  "publicPaths": [
    "/register"
  ],
  "auth": [
    {
      "key": "register",
      "title": "注册",
      "path": "/register",
      "capability": "auth.registration",
      "query": {
        "referral": "ref"
      },
      "fields": [
        {
          "key": "name",
          "label": "姓名",
          "type": "text"
        },
        {
          "key": "email",
          "label": "邮箱",
          "type": "email",
          "required": true
        },
        {
          "key": "password",
          "label": "密码（至少 10 位）",
          "type": "password",
          "required": true
        },
        {
          "key": "referral",
          "type": "hidden",
          "label": "推广来源"
        }
      ]
    }
  ],
  "pages": [
    {
      "id": "settings",
      "title": "账户注册",
      "icon": "users",
      "group": "系统",
      "roles": [
        "admin"
      ]
    }
  ],
  "versionEpoch": 1
}
