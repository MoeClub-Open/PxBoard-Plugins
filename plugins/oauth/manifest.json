{
  "id": "oauth",
  "apiVersion": "1.0",
  "minCoreVersion": "0.4.0",
  "name": "第三方登录",
  "version": "1.1.0",
  "description": "Google、GitHub、LinuxDO 登录及账号绑定",
  "category": "账户",
  "author": "PxBoard",
  "dependencies": {},
  "permissions": [
    "storage:own",
    "users:read",
    "users:create",
    "auth:login",
    "call:registration",
    "emit:account.registered"
  ],
  "events": ["system.tick"],
  "publicPaths": [
    "/providers",
    "/authorize",
    "/callback",
    "/registration",
    "/complete-registration"
  ],
  "pages": [
    {
      "id": "providers",
      "title": "第三方登录",
      "icon": "key",
      "group": "系统",
      "roles": [
        "admin"
      ]
    }
  ]
}
